generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Artigo { 
  id    Int     @id @default(autoincrement()) 
  titulo String  @unique
  DescricaoDoArtigo   String
  Autor String 
  DataPubli DateTime @default(now())
  Tags String 

  @@map("Artigos")
} 

